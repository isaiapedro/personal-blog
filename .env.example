# Copy to .env and replace every placeholder with a distinct secret. Never
# commit .env or paste its values into issues, logs, or documentation.
PORT=3000
ALLOWED_ORIGINS=http://localhost:4200
DB_USER=postgres
DB_HOST=127.0.0.1
DB_NAME=personal_blog
DB_PASSWORD=replace-with-a-unique-database-password
DB_PORT=5432
JWT_SECRET=replace-with-a-long-random-jwt-signing-secret
ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Required only for media-upload routes. Use a least-privilege IAM principal.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
S3_BUCKET_NAME=replace-with-private-or-publication-bucket-name

# Optional: translation requests are disabled when omitted.
# DEEPL_API_KEY=
SITE_URL=http://localhost:4200
